<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.oplist.openlist</string>
  <key>ProgramArguments</key>
  <array>
    <string>__OPENLIST_BIN__</string>
    <string>server</string>
    <string>--data</string><string>__HOME__/.config/openlist</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/.config/openlist</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.config/openlist/log/launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.config/openlist/log/launchd.log</string>
</dict>
</plist>
