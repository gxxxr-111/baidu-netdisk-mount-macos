<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.baidunetdisk.mount</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/.config/rclone/mount-baidu.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <!-- Restart if rclone exits (e.g. after sleep/network loss), but not in a tight loop. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/.config/rclone/launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.config/rclone/launchd.log</string>
</dict>
</plist>
